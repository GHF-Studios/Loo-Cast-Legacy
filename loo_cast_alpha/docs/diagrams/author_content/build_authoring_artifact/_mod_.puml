@startuml
!include ../../_theme.puml
title Authoring Artifact Build
top to bottom direction

package "Input Checks" {
  rectangle "Workspace Intake" as Workspace
  rectangle "Manifest Validation" as Manifests <<zoom>> [[validate_manifests/_mod_.puml]]
}

package "Payload Build" {
  rectangle "Rust Output Build" as Rust <<zoom>> [[build_rust_outputs/_mod_.puml]]
  rectangle "Rhai/Data Collection" as Rhai
}

package "Output Writing" {
  rectangle "Artifact Packing" as Pack <<zoom>> [[pack_artifact/_mod_.puml]]
  rectangle "Fingerprint Recording" as Fingerprints <<zoom>> [[write_fingerprints/_mod_.puml]]
}

Workspace --> Manifests : provides inputs to
Manifests --> Rust : approves
Manifests --> Rhai : approves collection of
Rust --> Pack : contributes native outputs to
Rhai --> Pack : contributes script/data payload to
Pack --> Fingerprints : produces bytes for
@enduml
