@startuml
!include ../_theme.puml
title Authoring Artifact Build
top to bottom direction

package "Input Checks" {
  rectangle "Workspace Intake" as Workspace
  rectangle "Manifest Validation" as Manifests <<zoom>> [[build_authoring_artifact/validate_manifests.puml]]
}

package "Payload Build" {
  rectangle "Rust Output Build" as Rust <<zoom>> [[build_authoring_artifact/build_rust_outputs.puml]]
  rectangle "Rhai/Data Collection" as Rhai
}

package "Output Writing" {
  rectangle "Artifact Packing" as Pack <<zoom>> [[build_authoring_artifact/pack_artifact.puml]]
  rectangle "Fingerprint Recording" as Fingerprints <<zoom>> [[build_authoring_artifact/write_fingerprints.puml]]
}

Workspace --> Manifests : provides inputs to
Manifests --> Rust : approves
Manifests --> Rhai : approves collection of
Rust --> Pack : contributes native outputs to
Rhai --> Pack : contributes script/data payload to
Pack --> Fingerprints : produces bytes for
@enduml
