@startuml
!include _theme.puml
title Packagepack Launch
top to bottom direction

package "Preflight" {
  rectangle "Packagepack Resolution" as Resolve <<zoom>> [[launch_packagepack/resolve_packagepack.puml]]
  rectangle "Installation Verification" as Verify
  rectangle "Capability Graph Build" as Graph <<zoom>> [[launch_packagepack/build_capability_graph.puml]]
}

package "Runtime Admission" {
  rectangle "Kernel Artifact Loading" as Kernels <<zoom>> [[launch_packagepack/load_kernel_artifacts.puml]]
  rectangle "Runtime Locking" as Lock <<zoom>> [[launch_packagepack/lock_runtime.puml]]
  rectangle "Engine/Game Startup" as Start
}

Resolve --> Verify : feeds plan to
Verify --> Graph : admits content to
Graph --> Kernels : supplies kernel refs to
Kernels --> Lock : registers surfaces for
Lock --> Start : permits
Verify --> Resolve : retries via
@enduml
